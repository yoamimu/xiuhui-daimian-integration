<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
		Hardened-runtime entitlements for 绣绘呆棉整合版 (Inkscape + Ink/Stitch).

		Inkscape embeds a Python runtime (PyInstaller) for the Ink/Stitch
		extension, so it must be allowed to load unsigned third-party dynamic
		libraries and execute JIT'd code from that runtime. These two
		entitlements are the minimal set required for notarization to pass
		without breaking the embedded Python.
	-->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
