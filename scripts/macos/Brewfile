# Brewfile for 绣绘呆棉整合版 macOS build (macOS 26+ "Tahoe")
#
# Supports both arm64 (native Apple Silicon, /opt/homebrew) and x86_64
# (Rosetta 2 / Intel, /usr/local) — install this Brewfile under the prefix
# matching the target MAC_ARCH.
#
# Used by scripts/macos/00-bootstrap.sh via `brew bundle install --file=Brewfile`.
#
# Versions are intentionally NOT pinned with @-suffixes here. macOS 26 just
# released and Homebrew bottles for Inkscape's GTK4 stack are being actively
# updated. We rely on `brew bundle install --upgrade` semantics and treat any
# version-related build break as a separate fix-up commit (see README_macOS.md
# "如果构建失败" section for the recommended pin procedure).

# --- toolchain ---
brew "cmake"
brew "ninja"
brew "pkg-config"
brew "meson"
brew "ccache"
brew "git"
brew "create-dmg"     # used by 05-make-dmg.sh
brew "jq"             # used by 03-build-inkstitch.sh
brew "xz"             # used by create-dmg / notarization tooling

# --- Inkscape required deps ---
brew "boost"
brew "double-conversion"
brew "bdw-gc"
brew "gsl"
brew "gtk4"
brew "gtkmm4"
brew "libxslt"
brew "libxml2"   # else pkg-config falls back to CommandLineTools' libxml2, whose -isystem CLT-SDK paths break libc++ header resolution
brew "gettext"
brew "adwaita-icon-theme"   # GTK4 默认图标主题；缺失会导致启动时 SIGSEGV

# --- Inkscape optional deps (matches msys2installdeps.sh "optional" block) ---
brew "enchant"
brew "graphicsmagick"
brew "gtksourceview5"
brew "libheif"
brew "libcdr"
brew "jpeg-xl"
brew "libspelling"
brew "libvisio"
brew "libwpg"
# poppler is NOT listed here: scripts/macos/pinned/poppler.rb pins it to
# 25.05.0 (newer poppler breaks Inkscape@7923d92 pdfinput API), installed
# by 00-bootstrap.sh before this bundle runs.
brew "potrace"

# --- Python runtime + Inkscape extension deps ---
brew "python@3.13"
brew "py3cairo"
# pygobject3 is only used by Ink/Stitch's optional DBus selection helper.
# It has no x86_64 bottle on current Homebrew and is not needed by the
# self-contained macOS app, so do not make Intel release builds depend on it.
brew "scour"

# --- Ink/Stitch macOS build deps (matches inkstitch .github/workflows/build.yml macarm64 job) ---
brew "geos"
brew "libffi"
brew "gnu-getopt"
brew "libiconv"
brew "webp"   # provides libwebp (formula renamed from libwebp)
brew "pango"
brew "cairo"
brew "gobject-introspection"
