 void CanvasPrivate::deactivate_graphics()
@@ -766,6 +773,7 @@ void CanvasPrivate::after_redraw()
 
     // Commit tiles before stores.finished_draw() to avoid changing stores while tiles are still pending.
     commit_tiles();
