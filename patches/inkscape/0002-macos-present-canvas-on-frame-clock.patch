@@ -1629,11 +1637,28 @@ const Geom::Affine &Canvas::get_geom_affine() const
     return d->canvasitem_ctx->affine();
 }
 
+void CanvasPrivate::request_present()
+{
+    if (present_tick || !q->get_mapped()) {
+        if (!present_tick) {
+            q->queue_draw();
+        }
+        return;
+    }
+
+    present_tick = q->add_tick_callback([this] (Glib::RefPtr<Gdk::FrameClock> const &) {
+        present_tick = 0;
+        q->queue_draw();
+        return false;
+    });
+}
+
 void CanvasPrivate::queue_draw_area(const Geom::IntRect &rect)
 {
-    q->queue_draw();
-    // Todo: Use the following if/when gtk supports partial invalidations again.
-    // q->queue_draw_area(rect.left(), rect.top(), rect.width(), rect.height());
+    // GTK4 no longer supports partial widget invalidation, so every present
+    // redraws the whole canvas. Present on the frame clock instead of after
+    // each tile to avoid flashing incomplete frames while drawing.
+    request_present();
 }
 
