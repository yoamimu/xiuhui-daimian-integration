DATABASE_PATH=/data/activation.db
FLASK_SECRET_KEY=replace-with-at-least-32-random-bytes
ADMIN_PASSWORD_HASH=replace-with-werkzeug-password-hash
LICENSE_CODE_PEPPER=replace-with-at-least-32-random-bytes
LICENSE_PRIVATE_KEY_PATH=/run/secrets/license_private_key.pem
LICENSE_TIMEZONE=Asia/Shanghai
OFFLINE_GRACE_HOURS=72
API_RATE_LIMIT=30
API_RATE_WINDOW_SECONDS=600
SESSION_COOKIE_SECURE=true
